# Get your key from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Port (default: 5000)
PORT=5000

# For deployment: set to your frontend domain
FRONTEND_URL=http://localhost:3000

# MongoDB Atlas connection string
# Get yours from: https://cloud.mongodb.com → Connect → Drivers → Node.js
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/interviewsaas?retryWrites=true&w=majority

# JWT Secret — use a long random string in production
JWT_SECRET=your_jwt_secret_key_change_this_to_something_random
